# Copy this file to .env in the Twilio/ directory and fill in real values.
# Never commit the real .env file - it's already covered by the repo's .gitignore.

# --- Required ---

# Google AI Studio API key (https://aistudio.google.com/)
API_KEY=your_google_gemini_api_key

# Twilio Account SID and Auth Token (https://www.twilio.com/console)
# Required to download MMS image attachments from Twilio's media URLs.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# --- Optional ---

# Gemini model to use for chat responses.
# GEMINI_MODEL_ID=gemini-2.5-flash

# Python logging level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# How many times to retry a failed Gemini call before giving up.
# MAX_RETRIES=5

# Seconds to wait before the first retry (doubles on each subsequent retry).
# INITIAL_RETRY_DELAY=1

# Override the interpreter/path used to launch the sports MCP subprocess.
# Defaults to the current Python interpreter and sports_mcp_server.py next to app.py.
# SPORTS_MCP_PYTHON=/path/to/python
# SPORTS_MCP_SERVER_PATH=/path/to/sports_mcp_server.py

# Host/port for local development only (python app.py). Render/gunicorn ignore these.
# HOST=0.0.0.0
# PORT=5000
