# Copy this file to .env in the Google-Voice/ directory and fill in real values.
# Never commit the real .env file - it's already covered by the repo's .gitignore.
# Requires python-dotenv (included in requirements.txt) - the script loads .env automatically.

# --- Required ---

# Google AI Studio / Generative AI API key (https://aistudio.google.com/)
API_KEY=your_google_genai_api_key

# The Gmail address this script logs into (used as the "From" address on replies).
# Should be the same account whose OAuth token you generate via credentials.json.
EMAIL_ADDRESS=your_gmail_address@gmail.com

# --- Optional ---

# Gemini model to use for chat responses. Defaults to gemini-2.0-flash.
# GEMINI_MODEL_ID=gemini-2.0-flash

# Python logging level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# --- Not set here ---
# credentials.json (OAuth client secret) and token.pickle (cached OAuth token)
# are files, not environment variables. See Google-Voice/README.md for how to
# generate credentials.json; token.pickle is created automatically on first run.
